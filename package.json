{
  "name": "thought-craft",
  "version": "0.1.0",
  "private": true,
  "description": "Capture ideas as Markdown notes and find them in a live Obsidian inbox.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:obsidian": "npm run build && node scripts/smoke-obsidian.mjs",
    "test:obsidian:m1": "npm run build && node scripts/smoke-m1.mjs",
    "test:obsidian:m2": "npm run build && node scripts/smoke-m2.mjs",
    "format": "prettier --write",
    "check": "npm run build && npm run lint && npm test",
    "install:dev": "node scripts/install-dev.mjs",
    "test:obsidian:m3": "npm run build && node scripts/smoke-m3.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "obsidian": "^1.8.7",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
